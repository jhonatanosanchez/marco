# Marco configuration. Copy to .env and edit (install.sh does this for you).
# Everything else (calendars, weather location, photos, screens…) is configured in the admin panel at /admin/.

# HTTP port of the server (display at /, admin at /admin/).
PORT=3000

# Optional: the URL you use to open the admin panel through a domain (e.g. https://calendar.example.com).
# Needed for Google sign-in / Google Calendar linking (the OAuth redirect URI is ${PUBLIC_URL}/auth/google/callback;
# Google only accepts https:// public domains or http://localhost here, see "Connecting Google Calendar" in the
# README) and to reach the server under that domain name. Default: derived from each request.
#PUBLIC_URL=https://calendar.example.com

# Optional: other host names the server answers to, comma-separated (".example.com" = any subdomain).
# The server refuses unknown host names (DNS-rebinding protection); IP addresses, localhost, single-label names
# (raspberrypi) and *.local / *.lan / *.home.arpa / *.internal always work, and so does the PUBLIC_URL host.
#ALLOWED_HOSTS=calendar.example.com

# Secret used to sign the session cookie. Use a long random string, e.g. `openssl rand -hex 32`.
# If left as "change-me"/empty, a random one is generated and stored in data/secrets.json.
SESSION_SECRET=change-me

# First run: there is no default admin password. Open /admin/ and the setup wizard creates it (language,
# password, location, calendars, look). From your local network the wizard just works; from other networks it
# needs the one-time setup URL printed in the server log at startup.
# SETUP_TOKEN: if the server is reachable from outside your LAN, set a long random value here
# (e.g. `openssl rand -hex 16`, at least 16 characters): the wizard then always asks for it (open /admin/?setup=<token>).
#SETUP_TOKEN=
# SETUP_REQUIRE_TOKEN=1: always ask for the generated token from the log, even on the LAN (the Docker image sets it).
#SETUP_REQUIRE_TOKEN=1

# Optional, for headless installs: initial admin password instead of the wizard (used only while no password
# has been saved; the panel offers to change it). A value that does not meet the password rules (at least 10
# characters, not a common password) only works from your local network until you change it in the panel.
#ADMIN_PASSWORD=

# Optional: where data (config, secrets, photos, backups) is stored. Default: ./data
#DATA_DIR=/var/lib/marco

# Optional: "Secure" session cookie. By default it is decided per request (https -> Secure, plain http on
# the LAN -> not Secure), so the panel works over http://<server-ip>:3000 and through an HTTPS proxy at once.
# COOKIE_SECURE=1 forces it on, COOKIE_SECURE=0 off.
#COOKIE_SECURE=

# Optional: trusted reverse proxies for X-Forwarded-For/-Proto (default: loopback only). Needed whenever the
# proxy does not connect from 127.0.0.1: a proxy on another machine (TRUST_PROXY=192.168.1.10, or a
# comma-separated list), or any proxy in front of the Docker container (TRUST_PROXY=172.16.0.0/12). Without it,
# proxied clients are treated as remote (setup token required) and the cookie is not marked Secure.
#TRUST_PROXY=

# Optional: this server's LAN address for the display's welcome QR code when it cannot be detected (Docker).
#LAN_ADDRESS=192.168.1.50

# Optional: Google OAuth client (Google Cloud Console -> Google Auth Platform -> Clients -> "Web application").
# Enables "Sign in with Google" for the admin and linking Google calendars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: extra CA certificates for iCal feeds served with a private CA.
#NODE_EXTRA_CA_CERTS=/path/to/ca.pem
